<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <Deterministic>true</Deterministic>
    <RollForward>LatestMajor</RollForward>
    <NuGetAudit>false</NuGetAudit>
    <Version>0.1.1</Version>
    <Product>OSHelp</Product>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <DebugType>embedded</DebugType>
    <PathMap>$(MSBuildThisFileDirectory)=/_/oshelp/</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
